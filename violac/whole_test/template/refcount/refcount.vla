from viola.io import *;
import viola.os;
from viola.os import exit;
// Viola Reference Counting Test Template
// 覆盖引用计数的retain/release配对：别名、成员存储、返回值、
// 重新赋值、数组元素、容器方法、以及大量分配后内存是否回收
// （见开发疑问记录190）。

// 断言：条件不成立时打印并以致非零退出码结束（供测试脚本判定）
sq check(bool condition, string label) -> () {
    if (condition) {
        print("ok " + label + "\n");
    } else {
        print("FAILED " + label + "\n");
        exit(1);
    }
}

class ${CLASS_NAME} {
    string name;
    int weight;

    public sq __new__(string name, int weight) -> (this) {
        this.name = name;
        this.weight = weight;
    }

    public fn describe() -> (string result) {
        result = this.name + ":" + this.weight.toString();
    }
}

// 接收对象并把它存入自己的成员：成员存储必须retain，
// 否则调用方释放实参后成员的指针悬空
class ${HOLDER_NAME} {
    ${CLASS_NAME} held;

    public sq __new__(${CLASS_NAME} held) -> (this) {
        this.held = held;
    }

    public fn heldName() -> (string result) {
        result = this.held.name;
    }

    public fn heldDescribe() -> (string result) {
        result = this.held.describe();
    }
}

// 返回一个"借来的"成员：返回值槽位成为新的持有者
sq nameOf(${CLASS_NAME} x) -> (string result) {
    result = x.name;
}

// 析构时向日志追加一个字符的wrapper类：用于观察对象是否被释放
// （元组持有对象成员、未使用变量的尽早释放，见开发疑问记录192）
wrapper class ReleaseTicker {
    unsafe uint32 marker;

    public sq __new__() -> (this) {
        this.marker = 1;
    }

    public sq __del__() -> () {
        file log = open("refcount_ticker.log", "a", "utf-8");
        write(log, "x");
        del(super);
    }
}

fn makeTicker() -> (ReleaseTicker result) {
    result = ReleaseTicker();
}

fn tickerValue(ReleaseTicker t) -> (int result) {
    result = 1;
}

// 构造函数中赋常量值的成员：常量折叠不得删除该赋值语句
// （原先`this.seed = 123;`被折叠掉，构造出的对象成员保持未初始化，
// 见开发疑问记录193）
class ConstHolder {
    public int seed;

    public sq __new__() -> (this) {
        this.seed = 123;
    }
}

// 返回新建对象
sq make(string n, int w) -> (${CLASS_NAME} result) {
    result = ${CLASS_NAME}(n, w);
}

// 在数组上往复操作，元素所有权在数组间转移
sq arrayRoundTrip(int times, int round) -> (int result) {
    if (round >= times) {
        result = 0;
        return;
    }
    string[] base = ["${STRING_A}", "${STRING_B}", "${STRING_C}"];
    string first = base[0];
    string[] appended = base.append("${STRING_D}");
    string[] inserted = base.insert(1, "${STRING_E}");
    string[] sliced = appended[1:3];
    string[] joined = sliced.concat(base);
    string[] replaced = base => {
        [0] = "${STRING_F}"
    };
    // 结果只依赖内容：任一环节提前释放都会读出错误内容或崩溃。
    // 每个断言写成一次赋值（0.1不允许在同一作用域内对同一变量重复赋值）
    int ok1 = base.length() == 3 ? 1 : 0;
    int ok2 = first == "${STRING_A}" ? 1 : 0;
    int ok3 = appended.length() == 4 && appended[3] == "${STRING_D}" ? 1 : 0;
    int ok4 = inserted.length() == 4 && inserted[1] == "${STRING_E}" ? 1 : 0;
    int ok5 = sliced.length() == 2 ? 1 : 0;
    int ok6 = joined.length() == 5 ? 1 : 0;
    int ok7 = replaced[0] == "${STRING_F}" && replaced.length() == 3 ? 1 : 0;
    result = ok1 + ok2 + ok3 + ok4 + ok5 + ok6 + ok7 + arrayRoundTrip(times, round + 1);
}

// 反复创建与丢弃对象：内存未回收时本函数会持续增长。
// 同一对象由多个局部变量与成员共同持有，全部持有者离开作用域后应恰好释放一次
// （Viola的数据不可变，故不做重新赋值测试）
sq churn(int times, int round) -> (int result) {
    if (round >= times) {
        result = 0;
        return;
    }
    ${CLASS_NAME} a = ${CLASS_NAME}("${STRING_A}", round);
    ${CLASS_NAME} b = a;
    ${HOLDER_NAME} h = ${HOLDER_NAME}(b);
    string n = nameOf(a);
    string d = h.heldDescribe();
    int ok1 = n == "${STRING_A}" ? 1 : 0;
    int ok2 = d.count("${STRING_A}") == 1 ? 1 : 0;
    int ok3 = b.name == "${STRING_A}" ? 1 : 0;
    int ok4 = a.weight == round ? 1 : 0;
    result = ok1 + ok2 + ok3 + ok4 + churn(times, round + 1);
}

// 让对象在若干个持有者之间流转后归零
sq chain(${CLASS_NAME} x, int depth) -> (int result) {
    if (depth <= 0) {
        result = x.weight;
        return;
    }
    ${CLASS_NAME} y = x;
    ${HOLDER_NAME} h = ${HOLDER_NAME}(y);
    result = chain(y, depth - 1) + h.held.weight;
}

// 异步调用的实参元组持有对象实参：调用方的局部变量在等待之前已无使用而释放，
// 任务期间对象必须保持有效（未持有则会读到已释放的对象，见开发疑问记录191、192）
sq asyncArgLifetime(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    ${CLASS_NAME} local = ${CLASS_NAME}("${STRING_A}", round);
    async string read = nameOf(local);
    int same = read == "${STRING_A}" ? 1 : 0;
    result = asyncArgLifetime(rounds, next) + (1 - same);
}

// 返回元组持有被返回的对象：等待之后由调用方槽位接手，元组的释放不得
// 使返回值失效（见开发疑问记录192）
sq asyncReturnLifetime(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    async string read = nameOf(make("${STRING_B}", round));
    int same = read == "${STRING_B}" ? 1 : 0;
    result = asyncReturnLifetime(rounds, next) + (1 - same);
}

// 括号中的条件表达式后接二元运算：括号之后的运算不得被丢弃
// （括号是表达式的首个记号时，条件扫描曾把括号内的`?`当作顶层`?`，
// 使`+ 4`之后的部分不产生任何命令而被静默丢弃，见开发疑问记录193）
sq ternaryArithmetic(int seed) -> (int result) {
    int[] nums = [7, 8, 9];
    int sum1 = (seed >= 0 ? 2 : 3) + 4;
    int sum2 = (seed >= 0 ? 2 : 3) + (seed >= 0 ? 5 : 6);
    int sum3 = 4 + (seed >= 0 ? 2 : 3);
    int product = (seed >= 0 ? 2 : 3) * 5;
    int arraySum = (seed >= 0 ? 1 : 0) + nums[0];
    int ok = (sum1 == 6 ? 1 : 0) + (sum2 == 7 ? 1 : 0) + (sum3 == 6 ? 1 : 0)
             + (product == 10 ? 1 : 0) + (arraySum == 8 ? 1 : 0);
    result = ok;
}

// 异步调用的实参元组/返回元组持有的对象：任务结束后必须释放
// （包装体原先对实参/返回元组成员计数却不释放，对象因此永不回收，
// 见开发疑问记录193）
sq asyncArgTickRelease(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    ReleaseTicker tick = ReleaseTicker();
    async int got = tickerValue(tick);
    int bad = got == 1 ? 0 : 1;
    result = asyncArgTickRelease(rounds, next) - bad;
}

sq asyncReturnTickRelease(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    async ReleaseTicker made = makeTicker();
    int marker = made.marker;
    int bad = marker == 1 ? 0 : 1;
    result = asyncReturnTickRelease(rounds, next) - bad;
}

// 嵌套块内声明后从未被读取的对象：应在声明处之后立即释放（见开发疑问记录192）
sq unusedNestedRelease(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = round;
        return;
    }
    int next = round + 1;
    int inner = unusedNestedRelease(rounds, next);
    if (round >= 0) {
        ReleaseTicker unusedTick = ReleaseTicker();
    }
    result = inner;
}

// 异步声明且从未被读取的变量：其值在等待之后写入，故在等待之后释放
sq asyncUnusedRelease(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = round;
        return;
    }
    int next = round + 1;
    int inner = asyncUnusedRelease(rounds, next);
    if (round >= 0) {
        async string unusedText = nameOf(make("${STRING_C}", round));
        async ReleaseTicker unusedTick = makeTicker();
    }
    result = inner;
}

// 提前退出（return/throw）路径上同样要释放"异步声明且从未被读取"的变量：
// 其值由退出路径的等待写入，释放语句须插在退出路径的等待之后
// （原先只插在正常路径的块末尾，退出路径上的对象随函数退出而泄漏，
// 见开发疑问记录193第2条的答复、194）
class TickerError extends Exception {
    string note;

    public sq __new__(string msg) -> (this) {
        this.note = msg;
    }

    public fn what() -> (string result) {
        result = this.note;
    }
}

sq exitPathRelease(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    if (round >= 0) {
        async ReleaseTicker tick = makeTicker();
        int inner = exitPathRelease(rounds, next);
        result = inner;
        return;
    }
    result = 0;
}

sq throwPathRelease(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    try {
        async ReleaseTicker tick = makeTicker();
        throw TickerError("tick");
    } catch TickerError e {
        result = 1 + throwPathRelease(rounds, next);
    }
}

// 泛型函数体内的异步调用返回对象：取回按"取走"语义（成员置0，目标槽位接手
// 元组持有的那次引用），使这段文本不依赖变量的类型。原先按变量的类型决定
// 是否计数，而泛型函数体内的这段文本在实例化之前生成（类型还是泛型参数），
// 一律按"非对象"处理：对象在取回后被返回元组的析构释放，随后的读取与存储
// 作用在已释放的内存上（实测堆破坏，见开发疑问记录194）
fn stringIdentity::<T>(T x) -> (T result) {
    result = x;
}

sq genericAsyncObject(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    async string got = stringIdentity::<string>("${STRING_C}");
    int ok = got == "${STRING_C}" ? 1 : 0;
    result = genericAsyncObject(rounds, next) + ok;
}

// 泛型函数体内的异步调用返回数组：实参元组的C类型名同样要按实例化后的
// 类型名生成（原先残留占位类型名T$$array，生成的C代码引用不存在的类型，
// 见开发疑问记录193第4条、194）
fn pickArray::<T>(T[] src) -> (T[] result) {
    T[] local = src;
    result = local;
}

sq genericAsyncArray(int rounds, int round) -> (int result) {
    if (round >= rounds) {
        result = 0;
        return;
    }
    int next = round + 1;
    string[] src = ["${STRING_A}", "${STRING_B}"];
    async string[] got = pickArray::<string>(src);
    string[] local = got;
    int ok = local.length() == 2 && local[1] == "${STRING_B}" ? 1 : 0;
    result = genericAsyncArray(rounds, next) + ok;
}

// 异步多返回值取回：目标为本函数的返回值槽位（C层为指针形参，取回须解引用，
// 原先生成的代码把成员写到指针形参自身，gcc按类型不符报错，见开发疑问记录194）
fn twoStrings() -> (string a, string b) {
    a = "${STRING_D}";
    b = "${STRING_E}";
}

fn unpackToReturn() -> (string p, string q) {
    async p, q = twoStrings();
}

// 经auto声明的闭包：推断出真实类型后须替换变量的类型对象，否则调用点按
// 函数类型解析时读不到参数/返回类型（原先报AttributeError，见开发疑问记录194）
fn closureAuto(int seed) -> (int result) {
    auto bump = sq(int v) -> (int r) {
        r = v + seed;
    };
    result = bump(1);
}

// 泛型函数体内的闭包：捕获结构体的定义与成员转换文本须按实例化后的类型生成，
// 否则捕获泛型类型的形参时残留占位类型名（见开发疑问记录194）
fn captureInGeneric::<T>(T[] src) -> (size_t result) {
    auto sizeOf = sq() -> (size_t r) {
        r = src.length();
    };
    result = sizeOf();
}

sq main() -> () {
    // 1. 别名：两个局部变量各持一次引用
    ${CLASS_NAME} ${OBJ_A} = ${CLASS_NAME}("${STRING_A}", ${WEIGHT_A});
    ${CLASS_NAME} ${OBJ_B} = ${OBJ_A};
    check(${OBJ_A}.name == "${STRING_A}" && ${OBJ_B}.name == "${STRING_A}",
          "aliased locals keep the object alive");

    // 2. 成员存储：成员持一次引用，实参随后释放
    ${HOLDER_NAME} ${HOLDER_A} = ${HOLDER_NAME}(${OBJ_A});
    check(${HOLDER_A}.heldName() == "${STRING_A}", "member store keeps the object alive");

    // 3. 返回值槽位：返回借来的成员
    string ${NAME_A} = nameOf(${OBJ_A});
    check(${NAME_A} == "${STRING_A}", "returned borrowed member stays alive");

    // 4. 返回新建对象
    ${CLASS_NAME} ${OBJ_C} = make("${STRING_C}", ${WEIGHT_B});
    check(${OBJ_C}.describe().count("${STRING_C}") == 1, "returned fresh object");
    check(${OBJ_C}.name == "${STRING_C}" && ${OBJ_C}.weight == ${WEIGHT_B},
          "returned object keeps its members");

    // 5. 对象经"取自成员"的返回值再持有：持有者离开作用域后对象仍有效
    string ${NAME_A}_fromMember = ${HOLDER_A}.heldName();
    check(${NAME_A}_fromMember == "${STRING_A}", "member read through a second holder");

    // 6. 数组元素的所有权：字面量、下标、修改、切片、拼接
    ${CLASS_NAME}[] objs = [${CLASS_NAME}("${STRING_A}", 1), ${CLASS_NAME}("${STRING_B}", 2)];
    check(objs[0].name == "${STRING_A}" && objs[1].name == "${STRING_B}",
          "array literal elements stay alive");
    string[] texts = ["${STRING_A}", "${STRING_B}", "${STRING_C}"];
    string text0 = texts[0];
    check(text0 == "${STRING_A}", "array element read stays alive");
    check(texts.append("${STRING_D}").length() == 4, "array append");
    check(texts.insert(1, "${STRING_E}")[1] == "${STRING_E}", "array insert");
    check(texts[0:2].length() == 2, "array slice");
    check(texts.concat(texts).length() == 6, "array concat");
    string[] updated = texts => {
        [0] = "${STRING_F}"
    };
    check(updated[0] == "${STRING_F}" && updated.length() == 3,
          "array element update keeps the other elements");

    // 7. 多轮分配与释放：计数不配对时会在此处累积内存或提前释放
    int churnOk = churn(${CHURN_ROUNDS}, 0);
    check(churnOk == ${CHURN_ROUNDS} * 4, "repeated allocation and release");

    // 8. 数组方法在多轮中反复执行
    int arrayOk = arrayRoundTrip(${ARRAY_ROUNDS}, 0);
    check(arrayOk == ${ARRAY_ROUNDS} * 7, "array ownership across rounds");

    // 9. 对象在多个持有者之间流转后全部释放
    int chainOk = chain(${OBJ_A}, ${CHAIN_DEPTH});
    check(chainOk == ${WEIGHT_A} * ${CHAIN_DEPTH} + ${WEIGHT_A}, "objects released after the chain");

    // 10. 元组持有对象：异步调用的实参元组与返回元组在等待期间保持对象有效
    int asyncArgOk = asyncArgLifetime(30, 0);
    check(asyncArgOk == 0, "async argument tuple keeps the object alive");
    int asyncRetOk = asyncReturnLifetime(30, 0);
    check(asyncRetOk == 0, "async return tuple keeps the object alive");

    // 11. 声明后从未使用的对象尽早释放：其析构各向日志追加一个字符
    file tickTruncate = open("refcount_ticker.log", "w", "utf-8");
    write(tickTruncate, "");
    int unusedOk = unusedNestedRelease(30, 0);
    int asyncUnusedOk = asyncUnusedRelease(30, 0);
    file tickLog = open("refcount_ticker.log", "r", "utf-8");
    string ticks = read(tickLog);
    check(unusedOk == 30 && asyncUnusedOk == 30 && ticks.length() >= 60,
          "unused objects released early");

    // 12. 括号中的条件表达式后接二元运算（见开发疑问记录193）
    int ternaryOk = ternaryArithmetic(${WEIGHT_A});
    check(ternaryOk == 5, "parenthesized ternary followed by an operator");

    // 13. 构造函数中的常量成员赋值必须真正写入（见开发疑问记录193）
    ConstHolder holder = ConstHolder();
    check(holder.seed == 123, "constant member assignment in constructor");

    // 14. 异步实参/返回元组持有的对象在任务结束后释放（见开发疑问记录193）
    int tickArgOk = asyncArgTickRelease(30, 0);
    int tickRetOk = asyncReturnTickRelease(30, 0);
    file tickLog2 = open("refcount_ticker.log", "r", "utf-8");
    string ticks2 = read(tickLog2);
    check(tickArgOk == 0 && tickRetOk == 0 && ticks2.length() >= 120,
          "objects held by async tuples released");

    // 15. 提前退出（return/throw）路径上释放异步声明且从未被读取的对象
    // （见开发疑问记录194）
    file tickTruncate3 = open("refcount_ticker.log", "w", "utf-8");
    write(tickTruncate3, "");
    int exitOk = exitPathRelease(30, 0);
    int throwOk = throwPathRelease(30, 0);
    file tickLog3 = open("refcount_ticker.log", "r", "utf-8");
    string ticks3 = read(tickLog3);
    check(exitOk == 0 && throwOk == 30 && ticks3.length() >= 60,
          "unused async objects released on exit paths");

    // 16. 泛型函数体内的异步调用返回对象/数组（见开发疑问记录194）
    int genObjOk = genericAsyncObject(30, 0);
    check(genObjOk == 30, "generic async call returning an object");
    int genArrOk = genericAsyncArray(30, 0);
    check(genArrOk == 30, "generic async call returning an array");

    // 17. 异步多返回值取回到函数返回值槽位（见开发疑问记录194）
    string retP, string retQ = unpackToReturn();
    check(retP == "${STRING_D}" && retQ == "${STRING_E}",
          "async multi-return into return slots");

    // 18. 经auto声明的闭包变量（见开发疑问记录194）
    int closureOk = closureAuto(${WEIGHT_A});
    check(closureOk == ${WEIGHT_A} + 1, "closure declared with auto");
    size_t captureOk = captureInGeneric::<string>(["${STRING_A}", "${STRING_B}", "${STRING_F}"]);
    check(captureOk == 3, "closure capturing a generic parameter");

    print("0.1 reference counting test completed\n");
}
