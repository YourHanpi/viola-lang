// 除wrapper与unsafe类外不得重写__del__（见开发疑问记录196）：
// 期望报错：Class main.Plain can not define __del__: it is generated by the compiler.
from viola.io import *;

class Plain {
    int v;

    public sq __new__(int x) -> (this) {
        this.v = x;
    }

    public fn __del__() -> () {
        print("no\n");
    }
}

sq main() -> () {
    print("hi\n");
}
