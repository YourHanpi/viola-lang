from viola.io import *;
// Viola 0.1 运行库综合测试
// 测试：viola.lang.string、viola.io（print/文件读写）、viola.math、
//       viola.os、viola.threads、viola.util.control_flow、viola.util.functools

import viola.util.control_flow as control_flow;
import viola.util.functools as functools;
import viola.util.array as array;
import viola.os;
import viola.os.path;
from viola.math import *;
from viola.os import exit, Stat;
from viola.threads import *;

fn doubleValue(int x) -> (int result) {
    result = x * 2;
}

fn isEven(int x) -> (bool result) {
    result = (x % 2) == 0;
}

fn sumChunk(int[] chunk) -> (int result) {
    // 末块元素可能不足reduceSize个（数组切片按实际长度截断），只累加
    // 实际存在的元素：原先固定读chunk[1]会越界读取未初始化内存，
    // 使reduce结果偶发错误（见开发疑问记录119）
    if (chunk.length() > 1) {
        result = chunk[0] + chunk[1];
    } else {
        result = chunk[0];
    }
}

fn increment(int x) -> (int r) {
    r = x + 1;
}

fn lessThanFive(int x) -> (bool c) {
    c = x < 5;
}

// 调用长度不等的dist（dist会抛出异常，本函数不捕获，用于验证跨函数传播）
fn thrower(double[] a, double[] b) -> (double result) {
    result = dist(a, b);
}

// 无返回值函数：以语句形式异步调用（async writeMarker(...);）时，
// 应在所在函数返回前被等待（见开发疑问记录122）
sq writeMarker(string text) -> () {
    file markerFile = open("void_async_marker.txt", "w", "utf-8");
    write(markerFile, text);
}

// 在函数体内以语句形式发起异步调用：函数返回前应等待其完成
sq triggerVoidAsync(string text) -> () {
    async writeMarker(text);
}

// 写入指定路径的标记文件（供提前return的等待测试使用）
sq writeMarkerTo(string path, string text) -> () {
    file markerFile = open(path, "w", "utf-8");
    write(markerFile, text);
}

// 以语句形式发起异步调用后立即return：等待应插在return之前
// （块末尾的等待语句被return绕过，见开发疑问记录130）
sq triggerVoidAsyncEarlyReturn(string path, string text) -> () {
    async writeMarkerTo(path, text);
    return;
}

// 条件提前return（return位于嵌套的if块内）：应同样等待
sq triggerVoidAsyncConditionalReturn(string path, string text) -> () {
    async writeMarkerTo(path, text);
    if (text.length() > 0) {
        return;
    }
    writeMarkerTo(path, "not-returned\n");
}

// 慢速写入：先等待300ms再写，使"未等待"与"已等待"的差异可稳定观测
// （被调函数抛出异常的路径，见开发疑问记录133）
sq writeSlowMarkerTo(string path, string text) -> () {
    viola.os.sleep(300);
    writeMarkerTo(path, text);
}

// 以语句形式发起异步调用后调用会抛异常的函数（数组越界上报IndexError）：
// 异常使控制流跳到本块的清理标签，该路径上也应等待该任务
sq triggerVoidAsyncCalledThrow(string path, string text, int[] numbers) -> () {
    async writeSlowMarkerTo(path, text);
    int outOfRange = numbers[7];
}

// 慢速纯计算：斐波那契（无资源请求，不依赖主线程处理请求），为异步任务提供
// 足够长的执行时间，其返回值本身即观测量（见开发疑问记录136）
fn slowFib(int n) -> (int result) {
    if (n < 2) {
        result = n;
    } else {
        int a = slowFib(n - 1);
        int b = slowFib(n - 2);
        result = a + b;
    }
}

// 按变量等待的异步调用（async int marker = ...）后使本块发生异常跳转：
// 变量在异常之前未被使用，故等待语句位于块末尾、被异常跳转绕过，任务在
// 该路径上原先无人等待（见开发疑问记录136）
sq triggerAsyncVarCalledThrow(int[] numbers) -> () {
    int marker;
    try {
        async marker = slowFib(30);
        int outOfRange = numbers[7];
        check(false, "async var waits on exception path");
    } catch Exception e {
        // 已等待并复制回marker时其值为fib(30)
        check(marker == 832040, "async var waits on exception path");
    }
}

// 语句形式的异步调用，其任务自身抛出异常：块末尾的等待取回该异常后会跳到
// 清理标签，该路径上不得对已释放的监听器重复等待（否则进程崩溃，
// 见开发疑问记录136）
sq throwerVoid(int[] a) -> () {
    int outOfRange = a[7];
}

sq triggerVoidThrowingAsync(int[] numbers) -> () {
    async throwerVoid(numbers);
}

// 同上的提前return形式：退出路径上的等待同样应把取回的任务异常发布给调用方
// （见开发疑问记录139）
sq triggerVoidThrowingAsyncEarlyReturn(int[] numbers) -> () {
    async throwerVoid(numbers);
    return;
}

// 有返回值的函数：以语句形式异步调用时返回值无处可取，但调用方仍须分配
// 返回元组——$async包装会把返回值写入returns->$i（见开发疑问记录138）
sq writeMarkerReturning(string path, string text) -> (int result) {
    file markerFile = open(path, "w", "utf-8");
    write(markerFile, text);
    result = text.length();
}

sq triggerVoidAsyncReturning(string path, string text) -> () {
    async writeMarkerReturning(path, text);
}

// 无实参的语句形式异步调用：调用以args=NULL入队，实参元组未分配，不得对其
// 生成释放判断（见开发疑问记录138的附带发现）
sq writeNoArgMarker() -> () {
    writeMarkerTo("void_async_noarg_marker.txt", "no-arg\n");
}

sq triggerVoidAsyncNoArg() -> () {
    async writeNoArgMarker();
}

// 函数值（闭包）的语句形式异步调用：实参由ClosureCallArgs打包、返回值需丢弃
// 目标，不得引用未声明的实参元组临时变量（见开发疑问记录138的附带发现）
sq triggerVoidAsyncFuncValue(int[] numbers) -> () {
    (int) -> (int) f = doubleValue;
    async f(numbers[0]);
}

// 多返回值的函数以语句形式异步调用：每个返回值各有一个丢弃目标，
// 返回元组的成员数与之一一对应（不做解包）
sq writeEchoMarker(string path, string text) -> (int count, string echoed) {
    writeMarkerTo(path, text);
    count = text.length();
    echoed = text;
}

sq triggerVoidAsyncMultiReturn(string path, string text) -> () {
    async writeEchoMarker(path, text);
}

// 按变量等待的异步调用（变量首次使用处的等待）取回的任务异常同样应发布给
// 调用方（见开发疑问记录139）：fn函数必须以返回值表达结果，故用越界读
fn throwingFib(int[] a) -> (int result) {
    result = a[7];
}

sq triggerAsyncVarThrowing(int[] numbers) -> () {
    async int marker = throwingFib(numbers);
    if (marker > 0) {
        writeMarkerTo("void_async_var_throwing_marker.txt", "no-exception\n");
    }
}

// =>更新表达式的源对象为函数调用：源表达式的返回值应物化到临时变量后再复制
// （原先生成memcpy(t, NULL, ...)，见开发疑问记录137）
fn makeNumbers(int n) -> (int[] result) {
    result = [n, n + 1, n + 2];
}

// 多返回值的异步调用（声明/赋值形式）：应真正异步执行（入队+在变量首次使用时
// 等待），返回值经调用方分配的返回元组取回（原先声明形式按同步调用生成、
// 赋值形式递归溢出，见开发疑问记录140）
fn pairReturn(int x) -> (int number, string text) {
    number = x + 1;
    text = "pair";
}

// 返回宽于int的类型（size_t）：用于验证以窄目标接收返回值（见开发疑问记录145）
fn wideReturn() -> (size_t n) {
    n = 9;
}

// 形参宽于整型字面量（double）：用于验证异步调用的实参按声明的形参类型传递
// （见开发疑问记录145）
fn halfOf(double x) -> (double r) {
    r = x / 2.0;
}

sq triggerMultiReturnDeclare(int x) -> () {
    async int number, string text = pairReturn(x);
    check(number == x + 1 && text == "pair", "async multi-return declaration");
}

sq triggerMultiReturnAssign(int x) -> () {
    int number;
    string text;
    async number, text = pairReturn(x);
    check(number == x + 1 && text == "pair", "async multi-return assignment");
}

// 丢弃用返回值目标含对象（string）：等待之后释放（受引用计数保护，当前不实际
// 释放，见开发疑问记录141）；此处断言被调函数的副作用已完成
sq triggerVoidAsyncObjectReturn(string path) -> () {
    async writeEchoMarker(path, "object-discard\n");
}

// 更新项（__setitem__）带副作用的类：用于验证语句形式的更新表达式确实执行了
// 更新项（见开发疑问记录142）
class UpdateRecorder {
    public string markerPath;
    public int applied;

    public sq __new__(string markerPath) -> (this) {
        this.markerPath = markerPath;
        this.applied = 0;
    }

    public sq __setitem__(int index, int value) -> (UpdateRecorder result) {
        writeMarkerTo(this.markerPath, "updated\n");
        result = this => { .applied = value };
    }
}

// 语句形式的更新表达式（同步）：结果被丢弃，更新照常执行
sq triggerUpdateStatementSync(string path) -> () {
    UpdateRecorder recorder(path);
    recorder => { [0] = 9 };
}

// 语句形式的更新表达式（异步）：用户定义的__setitem__有$async包装，
// 更新项以异步调用执行，语句内等待其完成后再继续
sq triggerUpdateStatementAsync(string path) -> () {
    UpdateRecorder recorder(path);
    async recorder => { [0] = 9 };
}

// 异步调用的实参按被调函数声明的形参类型进入实参元组：子类实参向父类形参的
// 隐式转换由C在元组填充处完成（语言允许子类向父类隐式转换，不允许反向，
// 见开发疑问记录149）
class ShapeBase {
    public int side;

    public sq __new__(int side) -> (this) {
        this.side = side;
    }
}

class ShapeSquare extends ShapeBase {
    public sq __new__(int side) -> (this) {
        super = ShapeBase(side);
    }
}

fn shapeSide(ShapeBase shape) -> (int result) {
    result = shape.side;
}

// 断言：条件不成立时打印并以致非零退出码结束（供测试脚本判定）
sq check(bool condition, string label) -> () {
    if (condition) {
        print("ok " + label + "\n");
    } else {
        print("FAILED " + label + "\n");
        exit(1);
    }
}

sq main() -> () {
    // 异常传播：dist长度不等应抛出异常（数据不可变，故判定放在各自分支内）
    double[] shortArr = [1.0, 2.0];
    double[] longArr = [1.0, 2.0, 3.0];
    try {
        double badDist = dist(shortArr, longArr);
        check(false, "dist length mismatch raises");
    } catch Exception e {
        check(true, "dist length mismatch raises");
    }
    double goodDist = dist(shortArr, shortArr);
    // 异常传播：被调函数内未捕获的异常跨函数传播到调用方的try/catch
    try {
        thrower(shortArr, longArr);
        check(false, "cross-function exception");
    } catch Exception e {
        check(true, "cross-function exception");
    }

    // 字符串操作
    string greeting = "Hello";
    string world = "World";
    string combined = greeting + ", " + world + "!";
    print(combined);
    string upper = combined.upper();
    print(upper);
    string lower = upper.lower();
    print(lower);
    string[] parts = combined.split(", ");
    size_t partCount = parts.length();
    check(combined == "Hello, World!", "string concat");
    check(upper == "HELLO, WORLD!", "string upper");
    check(lower == "hello, world!", "string lower");
    check(partCount == 2, "string split count");
    bool starts = combined.startsWith("Hello");
    check(starts, "string startsWith");
    check(greeting.repeat(2) == "HelloHello", "string repeat");

    // 文件读写
    file f = open("test_output.txt", "w", "utf-8");
    write(f, "line1\n");
    write(f, "line2\n");
    file fr = open("test_output.txt", "r", "utf-8");
    string content = read(fr);
    check(content == "line1\nline2\n", "file write/read roundtrip");

    // 数学
    double root = sqrt(16.0);
    double power = pow(2.0, 10.0);
    double piValue = pi;
    check(root == 4.0, "math sqrt");
    check(power == 1024.0, "math pow");
    check(piValue > 3.14, "math pi lower bound");
    check(piValue < 3.15, "math pi upper bound");

    // 线程（真实增减工作线程）
    uint32 threadCount = getThreadsNum();
    check(threadCount == 2, "threads initial count");
    addThread(1);
    uint32 newCount = getThreadsNum();
    check(newCount == 3, "threads addThread count");
    setThreadsNum(4);
    check(getThreadsNum() == 4, "threads setThreadsNum grow");
    setThreadsNum(2);
    check(getThreadsNum() == 2, "threads setThreadsNum shrink");
    // 增删线程后异步调用仍然正确
    async int threaded = doubleValue(21);
    check(threaded == 42, "threads async after churn");
    // 异步调用抛出的异常经由Listener传播到调用方的try/catch。
    // 读取异步变量才会等待其完成，故必须读取后才能观察到异常
    try {
        async double badAsync = thrower(shortArr, longArr);
        double observedAsync = badAsync;
        check(false, "async exception propagates");
    } catch Exception e {
        check(true, "async exception propagates");
    }

    // control_flow：forEach 与 while
    int[] numbers = [1, 2, 3, 4];
    int[] doubled = control_flow.forEach::<int, int>(numbers, doubleValue);
    check(doubled[0] == 2 && doubled[1] == 4 && doubled[2] == 6 && doubled[3] == 8, "control_flow.forEach");
    int loopResult = control_flow.while::<int>(1, increment, lessThanFive);
    check(loopResult == 5, "control_flow.while");

    // functools：map/filter/reduce（同步）
    int[] mapped = functools.map::<int, int>(numbers, doubleValue, false);
    check(mapped[0] == 2 && mapped[1] == 4 && mapped[2] == 6 && mapped[3] == 8, "functools.map sync order");
    int[] filtered = functools.filter::<int>(numbers, isEven, false);
    check(filtered.length() == 2 && filtered[0] == 2 && filtered[1] == 4, "functools.filter sync order");
    int reduced = functools.reduce::<int>([1, 2, 3, 4, 5, 6], sumChunk, 2);
    check(reduced == 21, "functools.reduce");

    // 数组越界检查：越界读应上报IndexError并可被catch捕获
    // （由VIOLA_ARRAY_BOUNDS_CHECK控制，默认开启，见开发疑问记录124）
    try {
        int outOfRange = numbers[4];
        check(false, "array bounds check");
    } catch Exception e {
        check(true, "array bounds check");
    }

    // 字符串越界读同样应上报异常（原先静默返回空串，与数组语义不一致，
    // 见开发疑问记录124的附带发现）
    string smallText = "ab";
    try {
        string outOfString = smallText[5];
        check(false, "string bounds check");
    } catch Exception e {
        check(true, "string bounds check");
    }

    // 切片步长为0应上报异常：元素个数按(end - start + step - 1) / step计算，
    // 步长为0时原先除以0（整数除零，实测触发SIGFPE/0xC0000094），见开发疑问记录135
    try {
        int[] zeroStepSlice = numbers[0:2:0];
        check(false, "slice zero step");
    } catch Exception e {
        check(true, "slice zero step");
    }

    // 切片赋值的范围检查：start > end时原先新长度按uint64下溢（malloc极大值
    // 失败后解引用空指针），现应上报异常（同样由VIOLA_ARRAY_BOUNDS_CHECK控制，
    // 见开发疑问记录129）
    // 更新表达式的下标/切片赋值同样作用于副本：原先__setitem__写入结果临时
    // 变量的新对象随即被"源对象的浅拷贝"覆盖，修改被静默丢弃
    // （见开发疑问记录134），故此处可直接断言结果值
    try {
        int[] validSlice = numbers => {
            [1:3] = [9, 9, 9]
        };
        check(validSlice.length() == 5 && validSlice[0] == 1 && validSlice[1] == 9 &&
              validSlice[2] == 9 && validSlice[3] == 9 && validSlice[4] == 4 &&
              numbers.length() == 4 && numbers[1] == 2, "slice range valid");
    } catch Exception e {
        check(false, "slice range valid");
    }
    try {
        int[] badSlice = numbers => {
            [3:1] = [9]
        };
        check(false, "slice range error");
    } catch Exception e {
        check(true, "slice range error");
    }

    // 下标更新的修改应保留，且多项更新串接到同一个副本上（源对象不变）
    int[] updatedIndex = numbers => {
        [0] = 7,
        [2] = 8
    };
    check(updatedIndex.length() == 4 && updatedIndex[0] == 7 && updatedIndex[1] == 2 &&
          updatedIndex[2] == 8 && updatedIndex[3] == 4 &&
          numbers[0] == 1 && numbers[2] == 3, "update expr index");

    // functools：map/filter（异步：每个元素的调用放入任务队列；map不保证顺序）
    int[] mappedAsync = functools.map::<int, int>(numbers, doubleValue, true);
    int asyncMapSum = mappedAsync[0] + mappedAsync[1] + mappedAsync[2] + mappedAsync[3];
    check(asyncMapSum == 20, "functools.map async values");
    int[] filteredAsync = functools.filter::<int>(numbers, isEven, true);
    check(filteredAsync.length() == 2 && filteredAsync[0] == 2 && filteredAsync[1] == 4,
          "functools.filter async order");

    // 跨模块泛型类（viola.util.array的Array::<T>，实例定义由该模块生成）
    array.Array::<int> wrapped(numbers);
    array.Array::<string> wrappedStrings(["a", "bb"]);
    array.Array::<int> extended = wrapped.append(5);
    check(wrapped.length() == 4 && extended.length() == 5 && wrapped.__getitem__(0) == 1,
          "util.array cross-module generic class");
    check(wrappedStrings.length() == 2 && wrappedStrings.__getitem__(1) == "bb",
          "util.array string instance");

    // 运行库原生函数的异步调用（原生$async包装，交工作线程执行）
    async string cwdAsync = viola.os.getcwd();
    string cwdText = cwdAsync;
    check(cwdText.length() > 0, "os.getcwd async");
    int32 fdSync = viola.os.open("async_probe.bin", viola.os.O_WRONLY | viola.os.O_CREAT | viola.os.O_TRUNC, 0o666);
    uint32 bytesWritten = viola.os.write(fdSync, "1234567");
    viola.os.close(fdSync);
    async Stat statAsync = viola.os.stat("async_probe.bin");
    Stat statSync = statAsync;
    check(statSync.st_size == 7, "os.stat async");
    async string[] entriesAsync = viola.os.listdir(".");
    string[] entriesSync = entriesAsync;
    check(entriesSync.length() > 0, "os.listdir async");
    file asyncReadFile = open("test_output.txt", "r", "utf-8");
    async string contentAsync = read(asyncReadFile);
    string contentSync = contentAsync;
    check(contentSync == "line1\nline2\n", "io.read async");

    // viola.os.path原生函数的异步调用（其$async包装由
    // gen_async_wrappers.py生成，见开发疑问记录131）
    async bool absAsync = viola.os.path.isabs(cwdText);
    bool absSync = absAsync;
    async bool existsAsync = viola.os.path.exists("test_output.txt");
    bool existsSync = existsAsync;
    async string baseAsync = viola.os.path.basename(cwdText);
    string baseSync = baseAsync;
    check(absSync && existsSync && baseSync.length() > 0, "os.path async");

    // 语句形式的异步调用（无赋值目标）应在所在函数返回前被等待：任务入队后
    // 若无人等待，函数可能在任务执行前结束（见开发疑问记录122）。
    // triggerVoidAsync在其函数末尾等待该任务，故此处读取标记文件时写入已完成
    triggerVoidAsync("awaited\n");
    file markerReadFile = open("void_async_marker.txt", "r", "utf-8");
    string markerText = read(markerReadFile);
    check(markerText == "awaited\n", "void async statement waits");

    // 提前return的路径同样应等待：先写入"pending"占位（任务未完成时读到它，
    // 不至于因文件不存在而报错），再由triggerVoidAsyncEarlyReturn内的异步
    // 调用覆盖为"early-return"；未等待时应读到占位内容
    string earlyPath = "void_async_return_marker.txt";
    file earlySetupFile = open(earlyPath, "w", "utf-8");
    write(earlySetupFile, "pending\n");
    triggerVoidAsyncEarlyReturn(earlyPath, "early-return\n");
    file earlyReadFile = open(earlyPath, "r", "utf-8");
    string earlyText = read(earlyReadFile);
    check(earlyText == "early-return\n", "void async waits before early return");

    // 条件提前return（return在嵌套的if块内）同样应等待
    string condPath = "void_async_cond_return_marker.txt";
    file condSetupFile = open(condPath, "w", "utf-8");
    write(condSetupFile, "pending\n");
    triggerVoidAsyncConditionalReturn(condPath, "cond-return\n");
    file condReadFile = open(condPath, "r", "utf-8");
    string condText = read(condReadFile);
    check(condText == "cond-return\n", "void async waits before conditional return");

    // 因异常跳转而离开块的路径同样应等待：被调函数抛出异常使控制流跳到本块的
    // 清理标签，该路径原先绕过块末尾的等待语句（见开发疑问记录133）。
    // 任务内先睡300ms再写，未等待时此处读到的是占位内容
    string excPath = "void_async_exc_marker.txt";
    file excSetupFile = open(excPath, "w", "utf-8");
    write(excSetupFile, "pending\n");
    try {
        triggerVoidAsyncCalledThrow(excPath, "exc-await\n", numbers);
        check(false, "void async waits on exception path");
    } catch Exception e {
        file excReadFile = open(excPath, "r", "utf-8");
        string excText = read(excReadFile);
        check(excText == "exc-await\n", "void async waits on exception path");
    }

    // 按变量等待的异步调用（async int marker = ...）在异常跳转路径上同样应等待：
    // 变量在异常之前未被使用，等待语句位于块末尾而被绕过，任务原先无人等待
    // （见开发疑问记录136）
    triggerAsyncVarCalledThrow(numbers);
    // 按变量等待的异步调用其任务抛出异常时，等待取回的异常同样应传播到调用方
    // （见开发疑问记录139）
    try {
        triggerAsyncVarThrowing(numbers);
        check(false, "async var task exception propagates");
    } catch Exception e {
        check(true, "async var task exception propagates");
    }

    // 语句形式的异步调用其任务自身抛出异常：等待取回的异常应传播到调用方，
    // 故此处应进入catch（原先只记入被调函数的$$exc，调用方捕获不到，
    // 见开发疑问记录139）；同时块末尾的等待取回该异常后会跳到清理标签，
    // 该路径上不得对已释放的监听器重复等待（见开发疑问记录136）
    try {
        triggerVoidThrowingAsync(numbers);
        check(false, "async task exception propagates");
    } catch Exception e {
        check(true, "async task exception propagates");
    }
    // 提前return的退出路径上同样应等待并把异常发布给调用方
    try {
        triggerVoidThrowingAsyncEarlyReturn(numbers);
        check(false, "async task exception crosses exit path");
    } catch Exception e {
        check(true, "async task exception crosses exit path");
    }

    // 语句形式异步调用"有返回值的函数"：返回值被丢弃，但不得崩溃
    // （原先以rets=NULL入队，工作线程向NULL返回元组写入，见开发疑问记录138）
    string returningPath = "void_async_returning_marker.txt";
    file returningSetup = open(returningPath, "w", "utf-8");
    write(returningSetup, "pending\n");
    triggerVoidAsyncReturning(returningPath, "returning-awaited\n");
    file returningRead = open(returningPath, "r", "utf-8");
    string returningText = read(returningRead);
    check(returningText == "returning-awaited\n", "void async returning function");
    // 原生函数的$async包装同样写入返回元组，故同样需要调用方分配
    async viola.os.getcwd();
    async viola.os.path.basename(cwdText);
    check(true, "void async returning native function");
    // 无实参的语句形式异步调用：实参元组不分配，不得对其做释放判断
    triggerVoidAsyncNoArg();
    file noArgReadFile = open("void_async_noarg_marker.txt", "r", "utf-8");
    string noArgText = read(noArgReadFile);
    check(noArgText == "no-arg\n", "void async no-arg statement");
    // 函数值（闭包）的语句形式异步调用：返回值丢弃、实参经ClosureCallArgs传递
    triggerVoidAsyncFuncValue(numbers);
    check(true, "void async function value statement");
    // 多返回值的语句形式异步调用：各返回值均为丢弃目标
    string echoPath = "void_async_multi_return_marker.txt";
    file echoSetup = open(echoPath, "w", "utf-8");
    write(echoSetup, "pending\n");
    triggerVoidAsyncMultiReturn(echoPath, "multi-awaited\n");
    file echoRead = open(echoPath, "r", "utf-8");
    string echoText = read(echoRead);
    check(echoText == "multi-awaited\n", "void async multi-return statement");

    // =>更新表达式的源对象为函数调用：源表达式的返回值先物化到临时变量再复制
    // （原先生成memcpy(t, NULL, ...)，见开发疑问记录137）
    int[] callSrcUpdated = makeNumbers(1) => {
        [0] = 9
    };
    check(callSrcUpdated.length() == 3 && callSrcUpdated[0] == 9 &&
          callSrcUpdated[1] == 2 && callSrcUpdated[2] == 3, "update expr call source");

    // 多返回值的异步调用（声明/赋值形式）：真正异步执行并取回全部返回值
    // （原先声明形式按同步调用生成、赋值形式递归溢出，见开发疑问记录140）
    triggerMultiReturnDeclare(numbers[0]);
    triggerMultiReturnAssign(numbers[1]);

    // 丢弃用返回值目标含对象：等待之后释放（见开发疑问记录141）
    string discardPath = "void_async_object_discard_marker.txt";
    file discardSetup = open(discardPath, "w", "utf-8");
    write(discardSetup, "pending\n");
    triggerVoidAsyncObjectReturn(discardPath);
    file discardRead = open(discardPath, "r", "utf-8");
    check(read(discardRead) == "object-discard\n", "discard object return released");

    // 语句形式的对象更新表达式：结果被丢弃，更新项必须执行（见开发疑问记录142）
    string syncUpdatePath = "update_statement_sync_marker.txt";
    file syncUpdateSetup = open(syncUpdatePath, "w", "utf-8");
    write(syncUpdateSetup, "pending\n");
    triggerUpdateStatementSync(syncUpdatePath);
    file syncUpdateRead = open(syncUpdatePath, "r", "utf-8");
    check(read(syncUpdateRead) == "updated\n", "update statement sync side effect");
    string asyncUpdatePath = "update_statement_async_marker.txt";
    file asyncUpdateSetup = open(asyncUpdatePath, "w", "utf-8");
    write(asyncUpdateSetup, "pending\n");
    triggerUpdateStatementAsync(asyncUpdatePath);
    file asyncUpdateRead = open(asyncUpdatePath, "r", "utf-8");
    check(read(asyncUpdateRead) == "updated\n", "update statement async side effect");

    // 返回值目标类型窄于被调函数返回类型：按返回类型中转后隐式转换
    // （原先按目标变量地址接收，越界写入相邻变量，见开发疑问记录145）
    int narrowCount = wideReturn();
    check(narrowCount == 9, "narrow return target sync");
    size_t wideNumber, string wideText = pairReturn(numbers[2]);
    check(wideNumber == numbers[2] + 1 && wideText == "pair", "wide return target sync");

    // 异步调用的实参按被调函数声明的形参类型传递，返回值经按声明返回类型构造
    // 的元组取回（见开发疑问记录145）
    async double halfValue = halfOf(1);
    check(halfValue == 0.5, "async arg type conversion");
    async int asyncNarrowCount = wideReturn();
    check(asyncNarrowCount == 9, "narrow return target async");

    // 内置数组类型方法的异步调用：$async包装由编译器生成（见开发疑问记录146）
    async int[] asyncAppended = numbers.append(5);
    check(asyncAppended.length() == numbers.length() + 1 &&
          asyncAppended[numbers.length()] == 5, "async array append");
    async int asyncLength = numbers.length();
    check(asyncLength == numbers.length(), "async array length narrow target");
    async double[] asyncDoubles = shortArr.append(3.5);
    check(asyncDoubles.length() == 3 && asyncDoubles[2] == 3.5, "async double array append literal");
    async int[] asyncUpdatedIndex = numbers => {
        [0] = 9
    };
    check(asyncUpdatedIndex.length() == numbers.length() && asyncUpdatedIndex[0] == 9,
          "async array setitem");

    // 方法表生成的其余数组方法（见开发疑问记录148）：concat、insert、
    // 切片读取（__getitem__$_1）、切片赋值（__setitem__$_1）与其异常路径
    int[] otherNumbers = [7, 8];
    async int[] asyncConcat = numbers.concat(otherNumbers);
    check(asyncConcat.length() == numbers.length() + otherNumbers.length() &&
          asyncConcat[numbers.length()] == 7 && asyncConcat[numbers.length() + 1] == 8,
          "async array concat");
    async int[] asyncInserted = numbers.insert(1, 42);
    check(asyncInserted.length() == numbers.length() + 1 && asyncInserted[0] == numbers[0] &&
          asyncInserted[1] == 42 && asyncInserted[2] == numbers[1], "async array insert");
    async int[] asyncSlice = numbers[1:3];
    check(asyncSlice.length() == 2 && asyncSlice[0] == numbers[1] &&
          asyncSlice[1] == numbers[2], "async array slice");
    async int[] asyncSliceSet = numbers => {
        [1:3] = [5, 6]
    };
    check(asyncSliceSet.length() == numbers.length() && asyncSliceSet[1] == 5 &&
          asyncSliceSet[2] == 6 && numbers[1] == 2, "async array slice setitem");
    try {
        async int[] asyncBadIndex = numbers => {
            [9] = 1
        };
        check(false, "async array index error");
    } catch Exception e {
        check(true, "async array index error");
    }
    try {
        // 变量在块末尾等待；此处先使用该变量以触发等待，异常在等待处回传
        async int[] asyncZeroStep = numbers[0:2:0];
        check(asyncZeroStep.length() == numbers.length(), "async array slice step error");
    } catch Exception e {
        check(true, "async array slice step error");
    }

    // 异步实参的子类向父类隐式转换：元组成员按声明的形参类型构造
    // （见开发疑问记录149）
    ShapeSquare asyncSquare = ShapeSquare(3);
    async int asyncShapeSide = shapeSide(asyncSquare);
    check(asyncShapeSide == 3, "async arg upcast");

    print("0.1 runtime library test completed\n");
}
