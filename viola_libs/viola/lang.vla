// Viola字符串类型声明。
//
// 命名空间：viola.lang（字符串类型的C名称为viola$lang$string）
// 实现位于viola_libs/viola/lang/string.c（内部使用UTF-16编码）。
// 字符串类型为编译器内置类型，此处以wrapper类提供其原生方法的Viola声明
// （分号代替函数体）。

import cpart "lang/string.h";

// 内置释放函数。del不是关键字，而是本模块的内置函数。
// del(super);（wrapper类__del__中释放普通成员）由编译器特殊处理：
// 生成当前类的$__del__super$_0调用；其余形式的del调用为原生空操作
// （实现于viola_libs/viola/runtime.c的viola$lang$del）。
sq del(object _this) -> ();

wrapper class string {
    // 构造函数（data为已有的uint16数组指针，长度未知时视为空字符串，
    // 主要供内部使用；实现于viola_libs/viola/lang/string.c）
    public sq __new__(ptr data) -> (this);
    // 字符串连接，等效于concat方法
    public fn __add__(string s) -> (string result);
    // 判断字符串是否相等
    public fn __eq__(string s) -> (bool result);
    // 返回字符串中第index个字符
    public fn __getitem__(int64 index) -> (string ch);
    // 返回字符串切片
    public fn __getitem__(slice s) -> (string result);
    // 字符串重复，等效于repeat方法
    public fn __mul__(uint64 times) -> (string result);
    // 判断字符串是否不相等
    public fn __ne__(string s) -> (bool result);
    // 字符串重复，等效于repeat方法
    public fn __rmul__(uint64 times) -> (string result);
    // 字符串连接
    public fn concat(string s) -> (string result);
    // 判断字符串是否以参数s结尾
    public fn endswith(string s) -> (bool result);
    // 判断字符串是否以参数s结尾
    public fn endsWith(string s) -> (bool result);
    // 判断字符串是否为ASCII字符串
    public fn isascii() -> (bool result);
    // 使用分隔符连接字符串
    public fn join(string[] s) -> (string result);
    // 获取字符串长度
    public fn length() -> (size_t result);
    // 返回字符串小写
    public fn lower() -> (string result);
    // 替换字符串中的子串
    public fn replace(string old, string new) -> (string result);
    // 字符串重复
    public fn repeat(uint64 times) -> (string result);
    // 从右按分隔符分割字符串
    public fn rsplit(string s) -> (string[] results);
    // 从右按分隔符分割字符串（最多maxsplit次）
    public fn rsplit(string s, uint64 maxsplit) -> (string[] results);
    // 返回字符串切片（start与end为负数时从末尾计数）
    public fn slice(int64 start, int64 end) -> (string result);
    // 按分隔符分割字符串
    public fn split(string s) -> (string[] results);
    // 按分隔符分割字符串（最多maxsplit次）
    public fn split(string s, uint64 maxsplit) -> (string[] results);
    // 判断字符串是否以参数s开头
    public fn startswith(string s) -> (bool result);
    // 判断字符串是否以参数s开头
    public fn startsWith(string s) -> (bool result);
    // 返回字符串的Unicode编码数组
    public fn unicode() -> (uint16[] result);
    // 返回字符串大写
    public fn upper() -> (string result);
    // ================= 0.1新增方法 =================
    // 统计sub非重叠出现的次数
    public fn count(string sub) -> (uint32 result);
    // 返回sub首次出现的索引（未找到返回UINT32_MAX）
    public fn find(string sub) -> (uint32 result);
    // 返回sub最后一次出现的索引（未找到返回UINT32_MAX）
    public fn rfind(string sub) -> (uint32 result);
    // 与find一致（未找到返回UINT32_MAX）
    public fn index(string sub) -> (uint32 result);
    // 与rfind一致（未找到返回UINT32_MAX）
    public fn rindex(string sub) -> (uint32 result);
    // 解析为浮点数（支持inf/nan与科学计数法）
    public fn float() -> (float64 result);
    // 解析为十进制整数
    public fn int() -> (int64 result);
    // 按base（2~16）解析为整数
    public fn int(uint8 base) -> (int64 result);
    // 十进制整数转换为字符串
    public static fn fromInt(int64 value) -> (string result);
    // 按base（2~16）将整数转换为字符串
    public static fn fromInt(int64 value, uint8 base) -> (string result);
    // 浮点数转换为字符串
    public static fn fromFloat(float64 value) -> (string result);
    // 值到字符串的转换：x.toString()按x的静态类型解析到下列函数
    // （基本类型不是类、没有方法表，见开发疑问记录166）。
    // bool的字符串形式与字面量一致（true/false）。
    public static fn _int32ToString(int32 value) -> (string result);
    public static fn _int64ToString(int64 value) -> (string result);
    public static fn _uint32ToString(uint32 value) -> (string result);
    public static fn _uint64ToString(uint64 value) -> (string result);
    public static fn _float64ToString(float64 value) -> (string result);
    public static fn _boolToString(bool value) -> (string result);
    public static fn _stringToString(string value) -> (string result);
    // 是否全部为字母或数字
    public fn isalnum() -> (bool result);
    // 是否全部为字母
    public fn isalpha() -> (bool result);
    // 是否全部为十进制数字
    public fn isdecimal() -> (bool result);
    // 是否全部为数字
    public fn isdigit() -> (bool result);
    // 是否为合法标识符
    public fn isidentifier() -> (bool result);
    // 是否全部为小写
    public fn islower() -> (bool result);
    // 是否全部为数字（含Unicode数字）
    public fn isnumeric() -> (bool result);
    // 是否全部为可打印字符
    public fn isprintable() -> (bool result);
    // 是否全部为空白字符
    public fn isspace() -> (bool result);
    // 是否全部为大写
    public fn isupper() -> (bool result);
    // 左对齐：在右侧用fillChar填充到length长度（"ab".ljust(4,"*") == "ab**"）
    public fn ljust(uint32 length, string fillChar) -> (string result);
    // 去除左侧空白（默认 " \t\n\r"）
    public fn lstrip() -> (string result);
    // 去除左侧toRemove集合中的字符
    public fn lstrip(string toRemove) -> (string result);
    // 右对齐：在左侧用fillChar填充到length长度（"ab".rjust(4,"*") == "**ab"）
    public fn rjust(uint32 length, string fillChar) -> (string result);
    // 去除右侧空白（默认 " \t\n\r"）
    public fn rstrip() -> (string result);
    // 去除右侧toRemove集合中的字符
    public fn rstrip(string toRemove) -> (string result);
    // 去除两侧空白（默认 " \t\n\r"）
    public fn strip() -> (string result);
    // 去除两侧toRemove集合中的字符
    public fn strip(string toRemove) -> (string result);
    // 大小写互换
    public fn swapcase() -> (string result);
    // 左侧补零到length长度（符号保持在最前）
    public fn zfill(uint32 length) -> (string result);
    // 替换子串（count为0时替换全部）
    public fn replace(string oldSub, string newSub, uint32 count) -> (string result);
    // 释放字符串数据
    public sq __del__() -> ();
}
